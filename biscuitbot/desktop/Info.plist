<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>biscuitbot</string>
    <key>CFBundleDisplayName</key>
    <string>biscuitbot</string>
    <key>CFBundleIdentifier</key>
    <string>com.biscuitbot.desktop</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>biscuitbot</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSUIElement</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- AppleScript 自动化（system_io 键盘模拟回退、douyin 技能） -->
    <key>NSAppleEventsUsageDescription</key>
    <string>biscuitbot needs AppleScript control to automate keyboard input and Safari interactions.</string>
    <!-- 屏幕截图（screenshot 工具） -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>biscuitbot needs screen capture access to take screenshots for visual understanding.</string>
    <!-- 辅助功能（pynput 键盘/鼠标模拟）通过 TCC 管理，无需 plist key，但此处声明用途 -->
    <key>NSHumanReadableCopyright</key>
    <string>MIT License</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
