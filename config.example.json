{
  "agents": {
    "defaults": {
      "workspace": "~/.hczkbot/workspace",
      "model": "deepseek/deepseek-v4-pro",
      "provider": "deepseek",
      "maxTokens": 8192,
      "contextWindowTokens": 65536,
      "temperature": 0.1,
      "maxToolIterations": 200,
      "maxConcurrentSubagents": 1,
      "maxToolResultChars": 16000,
      "providerRetryMode": "standard",
      "reasoningEffort": null,
      "timezone": "Asia/Shanghai",
      "botName": "hczk-bot",
      "botIcon": "🐺",
      "unifiedSession": false,
      "sessionTtlMinutes": 15,
      "maxMessages": 120,
      "consolidationRatio": 0.5,
      "disabledSkills": [],
      "dream": {
        "enabled": true,
        "intervalH": 2,
        "maxBatchSize": 50,
        "maxIterations": 3
      },
      "visionModel": null,
      "visionModelOverride": null
    }
  },

  "providers": {
    "anthropic": {
      "apiKey": "${ANTHROPIC_API_KEY}",
      "apiBase": "https://api.anthropic.com"
    },
    "openai": {
      "apiKey": "${OPENAI_API_KEY}",
      "apiBase": "https://api.openai.com/v1"
    },
    "deepseek": {
      "apiKey": "${DEEPSEEK_API_KEY}",
      "apiBase": "https://api.deepseek.com"
    },
    "dashscope": {
      "apiKey": "${DASHSCOPE_API_KEY}",
      "apiBase": "https://dashscope.aliyuncs.com/compatible-mode/v1"
    },
    "zhipu": {
      "apiKey": "${ZHIPU_API_KEY}",
      "apiBase": "https://open.bigmodel.cn/api/paas/v4"
    },
    "moonshot": {
      "apiKey": "${MOONSHOT_API_KEY}",
      "apiBase": "https://api.moonshot.ai/v1"
    },
    "stepfun": {
      "apiKey": "${STEPFUN_API_KEY}",
      "apiBase": "https://api.stepfun.com/v1"
    },
    "ollama": {
      "apiBase": "http://127.0.0.1:11434/v1"
    }
  },

  "modelPresets": {
    "deepseek": {
      "label": "DeepSeek V4 Pro",
      "model": "deepseek/deepseek-v4-pro",
      "provider": "deepseek",
      "maxTokens": 8192,
      "contextWindowTokens": 65536,
      "temperature": 0.1
    },
    "deepseek-r1": {
      "label": "DeepSeek R1（推理）",
      "model": "deepseek/deepseek-r1",
      "provider": "deepseek",
      "maxTokens": 8192,
      "contextWindowTokens": 65536,
      "temperature": 0.1
    },
    "qwen-max": {
      "label": "通义千问 Max（阿里）",
      "model": "dashscope/qwen-max",
      "provider": "dashscope",
      "maxTokens": 8192,
      "contextWindowTokens": 131072,
      "temperature": 0.1
    },
    "qwen-plus": {
      "label": "通义千问 Plus（阿里）",
      "model": "dashscope/qwen-plus",
      "provider": "dashscope",
      "maxTokens": 8192,
      "contextWindowTokens": 131072,
      "temperature": 0.1
    },
    "qwen-coder": {
      "label": "通义灵码（阿里）",
      "model": "dashscope/qwen-coder-plus",
      "provider": "dashscope",
      "maxTokens": 16384,
      "contextWindowTokens": 131072,
      "temperature": 0.1
    },
    "qwen-vl": {
      "label": "通义千问 VL（视觉）",
      "model": "dashscope/qwen-vl-max-latest",
      "provider": "dashscope",
      "maxTokens": 4096,
      "contextWindowTokens": 32768,
      "temperature": 0.1
    },
    "claude": {
      "label": "Claude Opus 4.5",
      "model": "anthropic/claude-opus-4-5",
      "provider": "anthropic",
      "maxTokens": 8192,
      "contextWindowTokens": 200000,
      "temperature": 0.1
    },
    "claude-sonnet": {
      "label": "Claude Sonnet 4",
      "model": "anthropic/claude-sonnet-4",
      "provider": "anthropic",
      "maxTokens": 8192,
      "contextWindowTokens": 200000,
      "temperature": 0.1
    },
    "gpt4o": {
      "label": "GPT-4o",
      "model": "openai/gpt-4o",
      "provider": "openai",
      "maxTokens": 4096,
      "contextWindowTokens": 128000,
      "temperature": 0.3
    },
    "o3": {
      "label": "OpenAI o3（推理）",
      "model": "openai/o3",
      "provider": "openai",
      "maxTokens": 16384,
      "contextWindowTokens": 200000,
      "temperature": 0.1,
      "reasoningEffort": "high"
    },
    "local": {
      "label": "本地模型（Ollama）",
      "model": "ollama/qwen2.5:14b",
      "provider": "ollama",
      "maxTokens": 4096,
      "contextWindowTokens": 32768,
      "temperature": 0.1
    },
    "glm-4": {
      "label": "GLM-4-Plus（智谱）",
      "model": "zhipu/glm-4-plus",
      "provider": "zhipu",
      "maxTokens": 8192,
      "contextWindowTokens": 128000,
      "temperature": 0.1
    },
    "glm-4-flash": {
      "label": "GLM-4-Flash（智谱/免费）",
      "model": "zhipu/glm-4-flash",
      "provider": "zhipu",
      "maxTokens": 8192,
      "contextWindowTokens": 128000,
      "temperature": 0.1
    },
    "kimi-k2": {
      "label": "Kimi K2（月之暗面）",
      "model": "moonshot/kimi-k2-0711-preview",
      "provider": "moonshot",
      "maxTokens": 8192,
      "contextWindowTokens": 131072,
      "temperature": 0.1
    },
    "step-2": {
      "label": "Step-2（阶跃星辰）",
      "model": "stepfun/step-2-16k",
      "provider": "stepfun",
      "maxTokens": 8192,
      "contextWindowTokens": 131072,
      "temperature": 0.1
    }
  },

  "tools": {
    "web": {
      "search": {
        "enable": true,
        "provider": "duckduckgo",
        "maxResults": 5,
        "timeout": 15
      },
      "fetch": {
        "enable": true,
        "useJinaReader": false
      }
    },
    "exec": {
      "enable": true,
      "timeout": 60,
      "sandbox": "",
      "restrictToWorkspace": false
    },
    "file": {
      "enable": true
    },
    "my": {
      "enable": true,
      "allowSet": true
    },
    "imageGeneration": {
      "enabled": false,
      "provider": "dashscope",
      "model": "wanx-v1"
    },
    "cliApps": {
      "enable": false
    },
    "systemIo": {
      "enable": false,
      "allowActions": []
    },
    "restrictToWorkspace": false,
    "guardLevel": "standard",
    "toolSelectionMode": "all",
    "dynamicToolMax": 10,
    "webuiAllowLocalServiceAccess": true,
    "ssrfWhitelist": [],
    "mcpServers": {}
  },

  "channels": {
    "sendProgress": true,
    "sendToolHints": true,
    "showReasoning": true,
    "extractDocumentText": true,
    "sendMaxRetries": 3,
    "websocket": {
      "enabled": true
    }
  },

  "transcription": {
    "enable": true,
    "provider": "dashscope",
    "model": "paraformer-realtime-v2",
    "apiKey": "${DASHSCOPE_API_KEY}"
  },

  "api": {
    "host": "127.0.0.1",
    "port": 8900,
    "timeout": 120.0
  },

  "gateway": {
    "host": "127.0.0.1",
    "port": 18790,
    "openBrowser": false,
    "heartbeat": {
      "enabled": false,
      "intervalS": 300,
      "keepRecentMessages": 8
    }
  }
}
